{
  "name": "hopper",
  "version": "0.1.0",
  "description": "Desktop database manager with per-connection pre-connection scripts (e.g. kubectl port-forward)",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "build:linux": "npm run typecheck && electron-vite build && electron-builder --linux",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "testdb:up": "docker compose -f docker/compose.yaml up -d",
    "testdb:down": "docker compose -f docker/compose.yaml down",
    "testdb:reset": "docker compose -f docker/compose.yaml down -v && docker compose -f docker/compose.yaml up -d",
    "testdb:logs": "docker compose -f docker/compose.yaml logs -f"
  },
  "dependencies": {
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
